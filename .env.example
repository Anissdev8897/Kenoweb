# Configuration Render/Cloud pour Keno Analyzer Pro
# Copier ce fichier en .env et ajuster les valeurs avant déploiement

# Database PostgreSQL (remplacée dynamiquement par Render)
DATABASE_URL=${DATABASE_URL}

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=${SECRET_KEY}


# API Keys
OPENAI_API_KEY=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

# Server Configuration
PORT=10000
HOST=0.0.0.0

# Database Extensions (si nécessaire en local)
POSTGRES_EXTENSIONS=uuid-ossp,pgcrypto

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log

# Security
ALLOWED_HOSTS=keno-analyzer-pro.onrender.com
CORS_ORIGINS=*

# File Storage
STATIC_FOLDER=static
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
