# Database PostgreSQL
DATABASE_URL=postgresql://keno_user:password@localhost:5432/keno_analyzer

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=your-secret-key-here-change-this

# API Keys
